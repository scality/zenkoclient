{
  "version": "1.0",
  "sources": ["models"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy.typescript:smithy-typescript-codegen:0.21.0"
    ]
  },
  "projections": {
    "json-client": {
      "plugins": {
        "typescript-client-codegen": {
          "service": "com.zenko.json#ZenkoJsonService",
          "package": "@zenko/json-client", 
          "packageVersion": "2.0.0",
          "protocol": "aws.protocols#restJson1"
        }
      }
    },
    "xml-client": {
      "plugins": {
        "typescript-client-codegen": {
          "service": "com.zenko.xml#ZenkoXmlService", 
          "package": "@zenko/xml-client",
          "packageVersion": "2.0.0",
          "protocol": "aws.protocols#restXml"
        }
      }
    }
  }
}
